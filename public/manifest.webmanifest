{
  "id": "./",
  "name": "Just Read",
  "short_name": "Just Read",
  "description": "Paste a link and read it here.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1015",
  "theme_color": "#0f1015",
  "categories": [
    "books",
    "entertainment"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "lang": "en",
  "display_override": [
    "standalone"
  ],
  "orientation": "any"
}
