{
  "name": "just-read",
  "version": "0.1.0",
  "private": true,
  "description": "Paste a link, read it here: an Android app that turns a manga or webtoon link into a reader.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:e2e": "node test/e2e/run.ts",
    "check": "npm run typecheck && npm test",
    "android:sync": "npm run build && cap sync android",
    "apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "linkedom": "^0.18.13",
    "playwright": "1.56.1",
    "typescript": "~5.9",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
