{
  "name": "just-read",
  "version": "0.1.0",
  "private": true,
  "description": "Paste a link, read it here: a PWA (and later an APK) that turns a manga or webtoon link into a reader.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "node proxy/node.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:e2e": "node test/e2e/run.ts",
    "check": "npm run typecheck && npm test",
    "icons": "node scripts/make-icons.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "linkedom": "^0.18.13",
    "playwright": "1.56.1",
    "typescript": "~5.9",
    "vite": "^7.3.7"
  }
}
