{
  "name": "just-read",
  "version": "0.1.0",
  "private": true,
  "description": "A PWA that turns a link into a manga reader.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/node.js",
    "dev": "node --watch server/node.js",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node test/e2e.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "linkedom": "^0.18.13",
    "playwright": "1.56.1"
  }
}
